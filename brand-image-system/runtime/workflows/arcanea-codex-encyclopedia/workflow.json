  "scoreThreshold": 28,
  "scoreScale": 30,
  "blockedRoutes": [
    "product chrome placement without Codex frame",
    "anime house unlabeled",
    "prompt soup without design card",
    "raw image_generate FAL thrash without xAI route-switch",
    "invent-a-verse entities outside CANON_LOCKED"
  ],
  "approvalRequired": true,
  "jobRootHint": "arcanea-ai-app/.arcanea/image-lab/<jobId>/",
  "relatedOperatingModel": "arcanea-ai-app/.arcanea/image-lab/ARCANEA_VISUAL_OS_OPERATING_MODEL.md",
  "updatedAt": "2026-07-16"
