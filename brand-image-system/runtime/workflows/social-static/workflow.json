{
  "$schema": "../../schemas/workflow-pack.schema.json",
  "workflowId": "social-static",
  "displayName": "Social Static Image",
  "purpose": "Create one exact, on-brand social image for a feed post, proof card, quote card, or announcement.",
  "surfaces": [
    "LinkedIn feed image",
    "Instagram feed image",
    "X image post",
    "Threads image post",
    "website social proof reuse"
  ],
  "allowedProductionRoutes": [
    "HTML/CSS renderer",
    "Satori/OG renderer",
    "Figma",
    "Canva",
    "browser capture",
    "image generation for background/source frame only"
  ],
  "requiredOutputs": [
    {
      "kind": "source brief",
      "pathHint": "brief.md"
    },
    {
      "kind": "media job",
      "pathHint": "media-job.json"
    },
    {
      "kind": "square crop",
      "pathHint": "crops/square.png",
      "dimensions": "1080x1080"
    },
    {
      "kind": "portrait crop",
      "pathHint": "crops/portrait.png",
      "dimensions": "1080x1350"
    },
    {
      "kind": "evidence",
      "pathHint": "evidence.json"
    }
  ],
  "qaGates": [
    "brand pack loaded",
    "exact text rendered deterministically",
    "actual output path exists",
    "square and portrait crop inspected",
    "30 point score recorded",
    "human approval required before public posting"
  ],
  "blockedRoutes": [
    "raw image generation containing final public text",
    "fake UI",
    "uncited claims",
    "generic gradient filler as primary asset",
    "Hermes image generation until backend is verified"
  ],
  "approvalRequired": true,
  "updatedAt": "2026-07-02"
}
