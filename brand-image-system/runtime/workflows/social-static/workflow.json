{
  "$schema": "../../schemas/workflow-pack.schema.json",
  "workflowId": "social-static",
  "displayName": "Social Static Image",
  "purpose": "Create one exact, on-brand social image for a proof card, quotation, announcement, or feed post.",
  "surfaces": ["LinkedIn image", "Instagram image", "X image", "Threads image", "website social proof"],
  "allowedProductionRoutes": ["HTML or Satori renderer", "Playwright capture", "Figma", "Canva", "owned browser capture", "generated background with deterministic public text"],
  "requiredOutputs": [
    { "kind": "source brief", "pathHint": "brief.md" },
    { "kind": "media job", "pathHint": "media-job.json" },
    { "kind": "square crop", "pathHint": "crops/square.png", "dimensions": "1080x1080" },
    { "kind": "portrait crop", "pathHint": "crops/portrait.png", "dimensions": "1080x1350" },
    { "kind": "open graph crop", "pathHint": "crops/og.png", "dimensions": "1200x628" },
    { "kind": "story crop", "pathHint": "crops/story.png", "dimensions": "1080x1920" },
    { "kind": "evidence", "pathHint": "evidence.json" }
  ],
  "qaGates": ["brand pack loaded", "exact text verified", "four crops inspected", "asset provenance recorded", "human approval before posting"],
  "scoreThreshold": 28,
  "scoreScale": 30,
  "blockedRoutes": ["raw generated public text", "fake UI", "uncited claim", "generic gradient filler", "uninspected output"],
  "approvalRequired": true,
  "updatedAt": "2026-07-24"
}
