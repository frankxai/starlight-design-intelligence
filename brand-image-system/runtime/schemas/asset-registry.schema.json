{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/brand-image-system/asset-registry.schema.json",
  "title": "File-verified media registrations, not publication or authenticated approval",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "starlight.assetRegistry.v1" },
    "assets": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "jobId", "brandId", "workflowId", "status", "registeredAt", "fingerprint", "job", "binding", "evidence", "approvalAssertion", "outputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
        "jobId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
        "brandId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "workflowId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "status": { "const": "file-verified" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "job": { "$ref": "#/$defs/artifact" }, "binding": { "$ref": "#/$defs/artifact" }, "evidence": { "$ref": "#/$defs/artifact" },
        "approvalAssertion": {
          "type": "object", "additionalProperties": false, "required": ["approver", "reviewedAt", "notes"],
          "properties": {
            "approver": { "type": "string", "minLength": 2 },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "notes": { "type": "string", "minLength": 3 }
          }
        },
        "outputs": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "bytes", "assetId", "versionId", "rightsStatus", "provenance"],
            "properties": {
              "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
              "assetId": { "type": "string", "pattern": "^asset_[a-f0-9]{24}$" },
              "versionId": { "type": "string", "pattern": "^ver_[a-f0-9]{32}$" },
              "rightsStatus": { "enum": ["owned", "generated-owned", "licensed"] },
              "provenance": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      }
    }
  }
}
