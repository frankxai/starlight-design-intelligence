{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/brand-image-system/media-job.schema.json",
  "title": "Brand Image System Media Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "brandId",
    "workflowId",
    "surface",
    "audience",
    "brief",
    "assetTier",
    "sourceMethod",
    "paths",
    "qa",
    "decision",
    "updatedAt"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "brandId": {
      "type": "string"
    },
    "workflowId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "productForm": {
      "type": "string",
      "enum": [
        "book",
        "course",
        "diagnostic",
        "guide",
        "implementation",
        "kit",
        "pack",
        "platform",
        "saas",
        "sprint",
        "community",
        "retainer",
        "workbook",
        "internal-hold"
      ]
    },
    "assetRole": {
      "type": "string",
      "enum": ["source-art", "cover-master", "launch-kit", "portfolio-overview"]
    },
    "surface": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "assetTier": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "blocked"]
    },
    "sourceMethod": {
      "type": "string"
    },
    "stylePackId": {
      "type": "string"
    },
    "rail": {
      "type": "string",
      "enum": ["product", "world", "none"]
    },
    "brandAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalPack", "logoDecision", "fonts", "colors"],
      "properties": {
        "canonicalPack": { "type": "string" },
        "logoDecision": { "type": "string" },
        "logos": { "type": "array", "items": { "type": "string" } },
        "fonts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "colors": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "exactCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "eyebrow": { "type": "string" },
        "statusLabel": { "type": "string" },
        "claims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelLane", "modelKnown", "capabilityReceipt", "promptVersion", "sourceRole"],
      "properties": {
        "modelLane": { "type": "string" },
        "declaredModel": { "type": ["string", "null"] },
        "modelKnown": { "type": "boolean" },
        "capabilityReceipt": { "type": "string" },
        "promptVersion": { "type": "string" },
        "sourceRole": { "type": "string" },
        "settings": { "type": "object" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimentId", "candidateId", "hypothesis"],
      "properties": {
        "experimentId": { "type": "string" },
        "candidateId": { "type": "string" },
        "baselineId": { "type": ["string", "null"] },
        "hypothesis": { "type": "string" }
      }
    },
    "promptLog": {
      "type": "string"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobRoot"],
      "properties": {
        "jobRoot": {
          "type": "string"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected", "score30", "notes"],
      "properties": {
        "inspected": {
          "type": "boolean"
        },
        "score30": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "socialConfidence100": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "notes": {
          "type": "string"
        },
        "dimensionScores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brandFit": { "type": "integer", "minimum": 0, "maximum": 5 },
            "formFit": { "type": "integer", "minimum": 0, "maximum": 5 },
            "craft": { "type": "integer", "minimum": 0, "maximum": 5 },
            "legibility": { "type": "integer", "minimum": 0, "maximum": 5 },
            "truthfulness": { "type": "integer", "minimum": 0, "maximum": 5 },
            "campaignUsefulness": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        "exportInspections": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["draft", "approved", "iterate", "restart", "blocked", "published"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    }
  }
}
