{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/brand-image-system/media-job.schema.json",
  "title": "Brand Image System Media Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "brandId",
    "workflowId",
    "surface",
    "audience",
    "brief",
    "assetTier",
    "sourceMethod",
    "paths",
    "qa",
    "decision",
    "updatedAt"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "brandId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "surface": {
      "type": "string",
      "minLength": 3
    },
    "audience": {
      "type": "string",
      "minLength": 3
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "assetTier": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "blocked"]
    },
    "sourceMethod": {
      "type": "string",
      "minLength": 3
    },
    "promptLog": {
      "type": "string"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobRoot"],
      "properties": {
        "jobRoot": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected", "score30", "notes"],
      "properties": {
        "inspected": {
          "type": "boolean"
        },
        "score30": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "socialConfidence100": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "reviewedAt", "notes"],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 2
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["draft", "approved", "iterate", "restart", "blocked", "published"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": ["approved", "published"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "required": ["approval"],
        "properties": {
          "assetTier": {
            "enum": ["A", "B", "C"]
          },
          "paths": {
            "required": ["jobRoot", "outputs", "evidence"]
          },
          "qa": {
            "properties": {
              "inspected": {
                "const": true
              },
              "score30": {
                "minimum": 26
              }
            }
          }
        }
      }
    }
  ]
}
