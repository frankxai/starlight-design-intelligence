{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/design-research-target.schema.json",
  "title": "Design research target",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "display_name", "source_owner", "canonical_url", "why", "capture_policy", "surfaces", "rights"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "starlight.design_research_target.v1" },
    "target_id": { "$ref": "#/$defs/id" },
    "display_name": { "type": "string", "minLength": 1 },
    "source_owner": { "type": "string", "minLength": 1 },
    "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "why": { "type": "string", "minLength": 24 },
    "capture_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locales", "freshness_days", "viewports", "raw_storage"],
      "properties": {
        "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "freshness_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "raw_storage": { "const": "private-r2-content-addressed" },
        "viewports": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "width", "height", "dpr"],
            "properties": {
              "name": { "enum": ["desktop-1440", "mobile-390", "reflow-320"] },
              "width": { "type": "integer", "minimum": 240, "maximum": 2560 },
              "height": { "type": "integer", "minimum": 480, "maximum": 1800 },
              "dpr": { "type": "number", "minimum": 1, "maximum": 4 }
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface_id", "kind", "url", "route"],
        "properties": {
          "surface_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["homepage", "product-overview", "feature", "conversion", "proof"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "route": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "rights": { "$ref": "#/$defs/rights" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "allowed_use", "prohibited_use", "reviewed_at"],
      "properties": {
        "state": { "enum": ["third-party-reference-only", "licensed-production-use", "owned"] },
        "allowed_use": { "type": "string", "minLength": 12 },
        "prohibited_use": { "type": "string", "minLength": 12 },
        "reviewed_at": { "type": "string", "format": "date" },
        "license_url": { "type": "string", "format": "uri" }
      }
    }
  }
}
